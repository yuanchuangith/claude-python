# One web port, loopback only. Do not bind to LAN without authentication.
APP_NAME=LocalDocRAG
APP_PORT=7860
APP_BIND=127.0.0.1
# Knowledge administration UI is maintained with the backend service.
LOCALDOC_FRONTEND_DIR=./frontend
GPU_MODE=auto
APP_LANGUAGE=zh-CN
MAX_UPLOAD_MB=100
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_VISION_MODEL=qwen3-vl:2b
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_CONTEXT_LENGTH=4096
OCR_BACKEND=rapidocr
OCR_DEVICE=cpu
ENABLE_OCR=true
ENABLE_IMAGE_CAPTION=true
ENABLE_DOCLING=false
ENABLE_MIXED_RETRIEVAL=true
RETRIEVE_DENSE_K=30
RETRIEVE_BM25_K=30
RAG_FINAL_TOP_K=8
ENABLE_OPTIONAL_RERANKER=false
MAX_IMAGE_SIDE=1400
MAX_IMAGE_COUNT_PER_DOC=300
GPU_TASK_CONCURRENCY=1
MODEL_CALL_TIMEOUT_SECONDS=180
INDEX_BATCH_SIZE=8
